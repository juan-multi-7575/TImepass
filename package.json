{
  "name": "timepass",
  "version": "1.0.0",
  "description": "Standalone zero-dependency Gemini web adapter package with dual-driver browser engine and lightweight Chrome MV3 extension",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "timepass": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint extension/ --ext .js"
  },
  "keywords": [
    "gemini",
    "adapter",
    "chrome-extension",
    "browser-automation",
    "playwright",
    "cdp",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
