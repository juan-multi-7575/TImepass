{
  "manifest_version": 3,
  "name": "Timepass Gemini Extension",
  "version": "1.0.0",
  "description": "Lightweight dedicated Chrome MV3 extension for timepass Gemini web automation",
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "contextMenus",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timepass Gemini Status"
  }
}
